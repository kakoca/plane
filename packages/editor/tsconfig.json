{
  "extends": "@plane/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/core/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/plane-editor/*": ["./src/ce/*"],
      "@plane/constants": ["../constants/src/index.ts"],
      "@plane/hooks": ["../hooks/src/index.ts"],
      "@plane/types": ["../types/src/index.ts"],
      "@plane/ui": ["../ui/src/index.ts"],
      "@plane/utils": ["../utils/src/index.ts"],
      "@plane/propel/*": ["../propel/src/*"]
    },
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "index.d.ts",
    "../ui/src/types/**/*.d.ts"
  ],
  "exclude": ["dist", "build", "node_modules"]
}
