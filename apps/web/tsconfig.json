{
  "extends": "@plane/typescript-config/react-router.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/app/*": ["app/*"],
      "@/*": ["core/*"],
      "@/helpers/*": ["helpers/*"],
      "@/styles/*": ["styles/*"],
      "@/plane-web/*": ["ce/*"],
      "@plane/graph-engine": ["../../packages/graph-engine/src/index.ts"],
      "@plane/graph-engine/*": ["../../packages/graph-engine/src/*"],
      "@graph-engine/*": ["../../packages/graph-engine/src/*"]
    },
    "strictNullChecks": true
  },
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "exclude": ["node_modules"]
}
